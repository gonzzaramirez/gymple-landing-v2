---
import { getCollection, render } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";

export async function getStaticPaths() {
  const posts = await getCollection("blog");
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);
const { title, description, pubDate, category, heroImage, faq } = post.data;

const categoryLabel = category === "comparativa" ? "Comparativa" : "Guía";
const dateLabel = pubDate
  ? pubDate.toLocaleDateString("es-AR", {
      year: "numeric",
      month: "long",
      day: "numeric",
    })
  : null;
---

<BlogLayout
  title={title}
  description={description}
  ogImage={heroImage}
  pubDate={pubDate}
  faq={faq ?? []}
>
  <article class="article-content">
    <div class="mb-6 flex flex-wrap items-center gap-3 text-sm">
      <span class="rounded-full bg-primary/10 px-3 py-1 font-semibold text-primary">{categoryLabel}</span>
      {dateLabel && <time datetime={pubDate.toISOString()} class="text-muted-foreground">{dateLabel}</time>}
    </div>

    <h1 class="!mt-0 text-balance text-3xl font-extrabold md:text-4xl">{title}</h1>
    <p class="mt-3 text-lg text-muted-foreground">{description}</p>

    {
      heroImage && (
        <img
          src={heroImage}
          alt={title}
          class="mt-8 w-full rounded-[1.5rem]"
          width={1200}
          height={630}
        />
      )
    }

    <div class="mt-8">
      <Content />
    </div>

    {
      faq && faq.length > 0 && (
        <section class="mt-12" aria-label="Preguntas frecuentes">
          <h2>Preguntas frecuentes</h2>
          <div class="mt-4 divide-y divide-border border-y border-border">
            {faq.map((item) => (
              <div class="py-4">
                <h3 class="!mt-0 text-base font-semibold">{item.question}</h3>
                <p class="mt-2 text-muted-foreground">{item.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </article>

  <div class="mt-10 rounded-[1.5rem] bg-primary px-6 py-8 text-center text-primary-foreground">
    <h2 class="text-balance text-xl font-extrabold">Probá Gymple gratis 14 días</h2>
    <p class="mt-2 text-primary-foreground/75">
      Automatizá la cobranza y la gestión de tu gimnasio. Sin tarjeta, hecho en Argentina.
    </p>
    <a
      href="/"
      class="mt-4 inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 font-semibold text-accent-foreground"
    >
      Conocer Gymple
    </a>
  </div>
</BlogLayout>
