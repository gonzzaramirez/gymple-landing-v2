---
import BlogLayout from "../../layouts/BlogLayout.astro";
import {
  gymTypes,
  cities,
  highPriorityCombinations,
  buildVertical,
  type VerticalPage,
} from "../../data/verticals";

export async function getStaticPaths() {
  return highPriorityCombinations.map(([typeKey, cityKey]) => {
    const type = gymTypes[typeKey];
    const city = cities[cityKey];
    return {
      params: { tipo: type.slug, ciudad: city.slug },
      props: { page: buildVertical(typeKey, cityKey) },
    };
  });
}

const { page } = Astro.props as { page: VerticalPage };

const trail = [
  { name: "Inicio", href: "/" },
  { name: "Recursos", href: "/recursos" },
  { name: `${page.typeLabel} en ${page.cityLabel}` },
];

const relatedVerticals = highPriorityCombinations
  .filter(([t]) => t === page.typeKey)
  .map(([, c]) => ({ label: `${page.typeLabel} en ${cities[c].label}`, href: `/recursos/software-${page.typeKey}-${cities[c].slug}` }));
---

<BlogLayout
  title={page.title}
  description={page.description}
  ogImage={page.heroImage}
  schema="service"
  serviceName="Gymple"
  breadcrumb={trail}
  faq={page.faq}
>
  <article class="article-content">
    <span class="mb-4 inline-block rounded-full bg-primary/10 px-3 py-1 text-sm font-semibold text-primary">
      {page.typeLabel} · {page.cityLabel}
    </span>

    <h1 class="!mt-0 text-balance text-3xl font-extrabold md:text-4xl">{page.h1}</h1>

    {
      page.heroImage && (
        <img
          src={page.heroImage}
          alt={`${page.typeLabel} en ${page.cityLabel}`}
          class="mt-8 w-full rounded-[1.5rem]"
          width={1200}
          height={630}
        />
      )
    }

    <p class="mt-6 text-lg text-muted-foreground">{page.hook}</p>
    <p>{page.lead}</p>

    <h2>Por qué importa en {page.cityLabel}</h2>
    <p>{page.localContext}</p>

    <h2>Lo que rescue un sistema de gestión para {page.typeLabel.toLowerCase()}</h2>
    <ul>
      {page.benefits.map((b) => <li>{b}</li>)}
    </ul>

    <h2>La cobranza en {page.cityLabel}</h2>
    <p>{page.paymentNote}</p>
    <p>
      Gymple cobra por transferencia, genera el comprobante y recorda el vencimiento por WhatsApp
      antes de que el socio se desarme la rutina. Menos planillas, menos morosidad, más tiempo para entrenar.
    </p>

    {
      page.faq.length > 0 && (
        <section class="mt-12" aria-label="Preguntas frecuentes">
          <h2>Preguntas frecuentes</h2>
          <div class="mt-4 divide-y divide-border border-y border-border">
            {page.faq.map((item) => (
              <div class="py-4">
                <h3 class="!mt-0 text-base font-semibold">{item.question}</h3>
                <p class="mt-2 text-muted-foreground">{item.answer}</p>
              </div>
            ))}
          </div>
        </section>
      )
    }
  </article>

  <section class="mt-10" aria-label="Otras ciudades">
    <h2 class="font-heading text-lg font-bold">Más {page.typeLabel} por ciudad</h2>
    <ul class="mt-3 flex flex-wrap gap-2">
      {
        relatedVerticals.map((r) => (
          <li>
            <a
              href={r.href}
              class="inline-flex rounded-full border border-border bg-card px-4 py-2 text-sm font-medium transition-colors hover:border-primary/40 hover:text-primary"
            >
              {r.label}
            </a>
          </li>
        ))
      }
      <li>
        <a
          href="/recursos"
          class="inline-flex rounded-full border border-border bg-card px-4 py-2 text-sm font-medium transition-colors hover:border-primary/40 hover:text-primary"
        >
          Ver todos los recursos
        </a>
      </li>
    </ul>
  </section>

  <div class="mt-10 rounded-[1.5rem] bg-primary px-6 py-8 text-center text-primary-foreground">
    <h2 class="text-balance text-xl font-extrabold">Probá Gymple para tu {page.typeLabel.toLowerCase()}</h2>
    <p class="mt-2 text-primary-foreground/75">
      14 días gratis. Cobranza automática, asistencia y finanzas en la nube, hecho en Argentina.
    </p>
    <a
      href="/"
      class="mt-4 inline-flex items-center gap-2 rounded-full bg-accent px-5 py-2.5 font-semibold text-accent-foreground"
    >
      Conocer Gymple
    </a>
  </div>
</BlogLayout>
