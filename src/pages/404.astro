---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="Página no encontrada — Gymple"
  description="La página que buscás no existe. Volvé al inicio de Gymple o explorá el sitemap."
  robots="noindex"
>
  <main class="flex min-h-screen items-center justify-center px-4 py-16">
    <div class="w-full max-w-xl rounded-[2rem] bg-secondary px-6 py-12 text-center md:px-12">
      <p class="font-heading text-sm font-bold uppercase tracking-widest text-muted-foreground">
        Error 404
      </p>
      <h1 class="mt-3 font-heading text-3xl font-extrabold leading-tight text-foreground md:text-4xl">
        Esta página no existe
      </h1>
      <p class="mx-auto mt-4 max-w-md text-pretty leading-relaxed text-muted-foreground">
        La dirección que pediste no corresponde a ninguna página de Gymple.
        Arrancá de nuevo desde el inicio o explorá el mapa del sitio.
      </p>
      <div class="mt-8 flex flex-wrap items-center justify-center gap-3">
        <a
          href="/"
          class="rounded-full bg-primary px-6 py-2.5 text-sm font-semibold text-primary-foreground transition-opacity hover:opacity-90"
        >
          Volver al inicio
        </a>
        <a
          href="/sitemap-index.xml"
          class="rounded-full px-6 py-2.5 text-sm font-semibold text-foreground ring-1 ring-border transition-colors hover:bg-card"
        >
          Ver sitemap
        </a>
      </div>
      <p class="mt-8 text-sm text-muted-foreground">
        ¿Sos un agente o un LLM? Encontrá la guía completa en
        <a href="/llms.txt" class="font-semibold text-foreground underline underline-offset-2">/llms.txt</a>.
      </p>
    </div>
  </main>
</BaseLayout>
