---
import BaseLayout from "../layouts/BaseLayout.astro";
import { Navbar } from "../components/Navbar";
import { Hero } from "../components/Hero";
import { Marquee } from "../components/Marquee";
import { Problems } from "../components/Problems";
import { Features } from "../components/Features";
import { PlatformSection } from "../components/PlatformSection";
import { BusinessModels } from "../components/BusinessModels";
import { ClientsCarousel } from "../components/ClientsCarousel";
import { Stats } from "../components/Stats";
import { Faq } from "../components/Faq";
import { Cta } from "../components/Cta";
import { Footer } from "../components/Footer";
import { faqData } from "../data/faq";
---

<BaseLayout
  title="Gymple. El software que automatiza tu gimnasio."
  description="Sistema de gestión para centros de entrenamiento: control de clientes, membresías, asistencia y finanzas. Hecho en Argentina, fácil de usar, en la nube."
  keywords="software para gimnasios Argentina, sistema de gestión gimnasios, programa para administrar gimnasios, control de clientes gimnasio, software fácil de usar, gestión centros de entrenamiento, membresías y finanzas, sistema en la nube Argentina, software barato para gimnasios, administración gimnasios moderna"
  faqSchema={faqData}
>
  <main class="overflow-x-hidden">
    <Navbar client:load />
    <Hero client:load />
    <Marquee client:load />
    <Problems client:load />
    <Features client:load />
    <PlatformSection client:load />
    <BusinessModels client:load />
    <ClientsCarousel client:load />
    <Stats client:load />
    <Faq client:load />
    <Cta client:load />
    <Footer />
  </main>
</BaseLayout>
